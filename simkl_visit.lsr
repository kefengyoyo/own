#!name=Simkl Visit
#!desc=捕获你本人在 simkl.com 的 Cookie，并定时模拟正常访问首页。仅用于自己的账号会话维护；请勿分享 Cookie。
#!author=converted from sgmodule

[MITM]
hostname = %APPEND% simkl.com

[Script]
# 1) Cookie 捕获：访问 https://simkl.com/ 时触发。脚本内部会自动过滤掉从
#    passport.simkl.com / Google 登录跳转过来的跨站请求，避免头信息污染。
http-request ^https:\/\/simkl\.com\/ script-path=https://raw.githubusercontent.com/kefengyoyo/own/refs/heads/main/simkl_visit.js, requires-body=false, timeout=10, tag=获取CK, enable=true

# 2) 定时访问：默认 cron 表达式为每天 8 点(与原文件保持一致，注释中"每6小时"与该 cron 不符，可自行修改)。
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/kefengyoyo/own/refs/heads/main/simkl_visit.js, timeout=500, tag=Simkl Scheduled Visit, enable=true
