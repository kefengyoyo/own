#!name=京东比价
#!desc=原始/表格/弹窗/折线，原始，表格，折线不能同时开启, 点击商品详情页触发脚本\n1.打开慢慢买APP-我的页面（无需登录）获取cookie,会通知获取ck成功\n2.京东商品详情页会展示比价结果
#!author=小白脸,灰灰
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
#!date=2025-04-23

[Argument]
arg1 = switch,true,tag=获取token
arg2 = switch,false,tag=京东助手(禁用通知)
arg3 = switch,false,tag=原始版
arg4 = switch,false,tag=弹窗版
arg5 = switch,true,tag=折线版,desc=下面参数开关表格
arg6 = switch,false,tag=折线不展示表格

[MITM]
hostname=in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com
[Script]
request if ${url} ~= /^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$/i then script("https://raw.githubusercontent.com/mw418/Loon/main/script/jd_price.js") with enable=${arg1}, tag="京东比价获取token", timeout=60, requires_body=true
response if ${url} ~= /^https:\/\/in\.m\.jd\.com\/product\/.+?\.html/i then script("https://raw.githubusercontent.com/githubdulong/Script/master/jd_price1.js", "disable_notice=false") with enable=${arg2}, tag="京东助手", timeout=60, requires_body=true
response if ${url} ~= /^https:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js") with enable=${arg3}, tag="京东比价原始版", requires_body=true
request if ${url} ~= /^https:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://raw.githubusercontent.com/mw418/Loon/main/script/jd_price.js") with enable=${arg4}, tag="京东比价弹窗版"
response if ${url} ~= /^https:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://raw.githubusercontent.com/mw418/Loon/main/script/jd_price2.js", {${arg6}}) with enable=${arg5}, tag="京东比价折线版", timeout=30, requires_body=true