[Argument]
longitude = input, "113.94114", tag=经度(在线选点优先)
latitude = input, "22.544577", tag=纬度(在线选点优先)
accuracy = input, "25", tag=精度(米)
logLevel = select, "info", "off", "error", "warn", "debug", "all", tag=日志级别

[Script]
response if ${url} ~= /^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc/i then script("https://raw.githubusercontent.com/kefengyoyo/own/refs/heads/main/wloc.js", {${longitude}, ${latitude}, ${accuracy}, ${randomRadius}, ${logLevel}}) with tag="Apple WLOC", timeout=30, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save/i then script("https://raw.githubusercontent.com/kefengyoyo/own/refs/heads/main/wloc-settings.js") with tag="WLOC Settings", timeout=10

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com