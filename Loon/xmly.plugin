#!name=xmly去广告
#!desc=xmly

[Rewrite]
request if ${url} ~= /https?:\/\/xdcs-collector(hera)?\.ximalaya\.com\/(api|nyx)\/v1/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/mobile-playpage\/view\//i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/chaos-notice-web\/v1\/message\/preview\/list/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/social-web\/bottomtabs\/dynamicentrance\/status/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.xmcdn\.com\/\w{8}\/\w{4}-\w{16}\/.+gif$/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/(dog-portal\/checkold|(child-mobile\/child|aged-mobile\/aged)\/mode\/query)/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/discovery-feed\/isshowusergiftpendant/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/mobile-user\/unread/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/mobile-user\/minorprotection\/pop/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/collector\/xl\/v\d/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/butler-portal\/versioncheck/i then reject(404)
request if ${url} ~= /https?:\/\/(adse\.wsa|adse|adbehavior)\.ximalaya\.com\/.*/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/mobile\/discovery\/v\d\/location/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/api\/v\d\/adrealtime/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/ting\/(loading|feed|home)?/i then reject(404)
request if ${url} ~= /https?:\/\/.*\.ximalaya\.com\/discovery-feed\/focus\/queryf/i then reject(404)
request if ${url} ~= /https?:\/\.*linkeye-cloud\/checkip/i then reject(404)
request if ${url} ~= /https?:\/\/www\.taobao\.com\/help\/getip\.php/i then reject(404)
request if ${url} ~= /https?:\/\.*audid-api\.taobao\.com/i then reject(404)
request if ${url} ~= /https?:\/\/passport(ws)?\.ximalaya\.com\/user-http-app\/v1\/token\/refresh/i then reject(404)

[Script]
response if ${url} ~= /https?:\/\/(mobile(hera)?|m(ob)?wsa|m)\.ximalaya\.com\/mobile(-user\/v\d\/homePage|-playpage\/(track\/v\d\/baseInfo|playpage\/(tabs\/v\d|recommend(\/resource\/allocation|ContentV\d)))|\/(album\/paid\/info|playlist\/album\/new)|\/v\d\/album\/track)/i then script("https://raw.githubusercontent.com/ClydeTime/Quantumult/main/Script/XMLY/xmly.js") with tag="xmly", timeout=60, requires_body=true

response if ${url} ~= /https?:\/\/(mobile(hera)?|m(ob)?wsa|m)\.ximalaya\.com\/business-vip-(presale-mobile-web\/page|level-h5-web\/api\/(gift\/detail|profile)|welfare-mobile-web\/welfare\/module\/exclusive\/list)/i then script("https://raw.githubusercontent.com/ClydeTime/Quantumult/main/Script/XMLY/xmly.js") with tag="xmly", timeout=60, requires_body=true

response if ${url} ~= /https?:\/\/(mobile(hera)?|m(ob)?wsa|m)\.ximalaya\.com\/discovery-(category\/customCategories|feed\/v\d\/(freeListenTab\/queryCardList|mix)|ranking-web\/v\d\/ranking\/concreteRankList)/i then script("https://raw.githubusercontent.com/ClydeTime/Quantumult/main/Script/XMLY/xmly.js") with tag="xmly", timeout=60, requires_body=true

response if ${url} ~= /https?:\/\/(mobile(hera)?|m(ob)?wsa|m)\.ximalaya\.com\/(browsing-history-business\/browsing\/history\/query|focus-mobile\/focusPic\/info|nyx\/history\/query\/(detail|id\/list)|product\/detail\/v\d\/basicInfo\/dynamic|subscribe\/v\d\/subscribe\/comprehensive\/rank|vip\/(feed\/v1\/mix|v\d\/recommand))/i then script("https://raw.githubusercontent.com/ClydeTime/Quantumult/main/Script/XMLY/xmly.js") with tag="xmly", timeout=60, requires_body=true

response if ${url} ~= /https?:\/\/search(wsa)?\.ximalaya\.com\/(hub\/)?(guideWordV\d|hotWord(V\d|Billboard\/card))/i then script("https://raw.githubusercontent.com/ClydeTime/Quantumult/main/Script/XMLY/xmly.js") with tag="xmly", timeout=60, requires_body=true

request if ${url} ~= /https?:\/\/(mobile(hera)?|m(ob)?wsa)\.ximalaya\.com\/(mobile-playpage\/track|mobile\/quickplay)/i then script("https://raw.githubusercontent.com/ClydeTime/Quantumult/main/Script/XMLY/xmly_ck.js") with tag="xmly_ck", timeout=60

[MITM]
hostname = *.ximalaya.com, 47.100.227.85, 61.164.145.12, 61.172.194.185, 61.172.194.186, 106.41.204.126, 112.80.180.72, 112.98.170.228, 112.99.146.108, 114.80.99.*, 118.25.119.177, 180.153.140.*, 180.153.250.*, 180.153.255.*
