#!name = GetCookies
#!desc = 获取cookie/token
#!author = Sliverkiss [https://github.com/Sliverkiss]
#!homePage = https://t.me/sliverkiss_blog
#!data = 2024-11-04
#!icon = https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/gril.png
#!system = iOS,iPadOS
#!loon_version = 3.2.3(753)

[Argument]
arg5 = switch,true,tag=龙湖天街获取token
arg7 = switch,true,tag=喜马拉雅获取token
arg8 = switch,true,tag=高德打车token
arg12 = switch,true,tag=Bilibili获取token
arg15 = switch,true,tag=52破解token
[Script]
request if ${url} ~= /^https?:\/\/gw2c\-hw\-open\.longfor\.com\/lmarketing\-task\-api\-mvc\-prod\/openapi\/task\/v1\/signature\/clock/i then script("https://raw.githubusercontent.com/leiyiyan/resource/main/script/lhtj/lhtj.js") with enable=${arg5}, tag="龙湖天街获取token", timeout=60, requires_body=true
request if ${url} ~= /^https?:\/\/xmc\.ximalaya\.com\/xmlymain-login-web\/login\//i then script("https://raw.githubusercontent.com/ClydeTime/Quantumult/main/Script/Task/xmlySign.js") with enable=${arg7}, tag="喜马拉雅获取token", timeout=60, requires_body=true
response if ${url} ~= /^https:\/\/(m5(|-zb)|dache)\.amap\.com\/(ws\/yuece\/(act|openapi\/activity\/current)\/query|common\/(alipaymini|wxmini)\?_ENCRYPT=)/i then script("https://raw.githubusercontent.com/wf021325/qx/master/task/ampDache.js") with enable=${arg8}, tag="高德打车token", timeout=60, requires_body=true
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/fingerprint\?/i then script("https://raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js") with enable=${arg12}, tag="Bilibili获取token(APP)", timeout=60, requires_body=true
request if ${url} ~= /^https?:\/\/m.bilibili.com\/$/i then script("https://raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js") with enable=${arg12}, tag="Bilibili获取token(网页)", timeout=60, requires_body=true
request if ${url} ~= /^https:\/\/www\.52pojie\.cn\/home\.php\?/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/52pojie.js") with enable=${arg15}, tag="52破解获取token", timeout=10, requires_body=true
[MITM]
hostname = gw2c-hw-open.longfor.com,xmc.ximalaya.com,*.amap.com, dache.amap.com,mobile.ximalaya.com,app.bilibili.com, m.bilibili.com, www.52pojie.cn
